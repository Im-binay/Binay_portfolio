endobj
36 0 obj<</ActualText(03)/K[27]/P 87 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
37 0 obj<</ActualText(Students living\n independently)/K[28]/P 88 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
38 0 obj<</ActualText(04)/K[29]/P 89 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
39 0 obj<</ActualText( ’Final UI)/K[30]/P 90 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
40 0 obj<</ActualText( ’Prototype)/K[31]/P 91 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
41 0 obj<</ActualText(An interactive Figma prototype was created to connect the final UI screens and demonstrate the complete user journey, from discovering a service to booking and payment.)/K[32]/P 92 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
42 0 obj<</ActualText(View Interactive Prototype ’ )/K[33]/P 93 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
43 0 obj<</ActualText( ’Design System)/K[34]/P 94 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
44 0 obj<</ActualText(A 60-30-10 palette  white for space, charcoal for structure, gold for the one action that matters on each screen)/K[35]/P 95 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
45 0 obj<</ActualText(White)/K[36]/P 96 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
46 0 obj<</ActualText(Charcoal Black)/K[37]/P 97 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
47 0 obj<</ActualText(Gold\n)/K[38]/P 98 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
48 0 obj<</ActualText( ’challenges  AND design decision)/K[39]/P 99 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
49 0 obj<</ActualText(Challenges)/K[40]/P 100 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
50 0 obj<</ActualText(The main challenges were organizing multiple service categories without overwhelming users, keeping the booking process simple and easy to follow, and presenting provider information clearly so users could make informed decisions.)/K[41]/P 101 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
51 0 obj<</ActualText(Decision Outcomes)/K[42]/P 102 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
52 0 obj<</ActualText(To address these challenges, I used a clean interface with minimal distractions, grouped services into clear categories for easier navigation, and designed a step-by-step booking process. Consistent UI components and visual patterns were used throughout the app to improve usability and create a cohesive experience.)/K[43]/P 103 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
53 0 obj<</ActualText( ’What i Learned)/K[44]/P 104 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
54 0 obj<</K[45]/P 105 0 R/S/Span/Pg 8 0 R/Type/StructElem>>
endobj
55 0 obj<</ActualText(KAARIGHAR  CASE STUDY)/K[46]/P 106 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
