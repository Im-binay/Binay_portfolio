10 0 obj<</ActualText(KaariGhar)/K[1]/P 61 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
11 0 obj<</ActualText(Find the right help, effortlessly.)/K[2]/P 62 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
12 0 obj<</ActualText(A mobile application that helps people find and book trusted home service professionals  electricians, plumbers, carpenters, and cleaners  built to replace word-of-mouth with a faster, more reliable process.)/K[3]/P 63 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
13 0 obj<</ActualText(Role)/K[4]/P 64 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
14 0 obj<</ActualText(UI/Ux Designer)/K[5]/P 65 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
15 0 obj<</ActualText(Tool)/K[6]/P 66 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
16 0 obj<</ActualText(Figma)/K[7]/P 67 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
17 0 obj<</ActualText(Screens)/K[8]/P 68 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
18 0 obj<</ActualText(16 Screens)/K[9]/P 69 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
19 0 obj<</ActualText( ’Problems)/K[10]/P 70 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
20 0 obj<</ActualText(People often struggle to find reliable home service providers. Traditional methods rely on personal recommendations, which can be slow and unreliable. There is also no simple way to manage bookings or track service requests.)/K[11]/P 71 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
21 0 obj<</ActualText( ’Goals)/K[12]/P 72 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
22 0 obj<</ActualText(Design an app that lets users.)/K[13]/P 73 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
23 0 obj<</ActualText( Find service providers\n Book services easily \n Track booking status \n Make secure payment)/K[14]/P 74 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
24 0 obj<</ActualText( ’Target Users)/K[15]/P 75 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
25 0 obj<</ActualText( ’Key insights)/K[16]/P 76 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
26 0 obj<</ActualText(Based on common expectations for service-booking platforms,\nI identified several features that would improve the user experience:)/K[17]/P 77 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
27 0 obj<</K[18]/P 78 0 R/S/Span/Pg 8 0 R/Type/StructElem>>
endobj
