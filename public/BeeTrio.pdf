10 0 obj<</ActualText(Bee Trio Trackers)/K[1]/P 59 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
11 0 obj<</ActualText(Beyond Boundaries , Delivering  Smiles)/K[2]/P 60 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
12 0 obj<</ActualText(A courier tracking web application designed to help customers monitor parcel deliveries while allowing administrators to manage shipments and update delivery statuses through a centralized system. As my first UI/UX project, it provided hands-on experience in designing user interfaces, organizing information, and creating workflows for both desktop and mobile devices.)/K[3]/P 61 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
13 0 obj<</ActualText(Role)/K[4]/P 62 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
14 0 obj<</ActualText(Tool)/K[5]/P 63 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
15 0 obj<</ActualText(Platforms)/K[6]/P 64 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
16 0 obj<</ActualText(UI/Ux Designer)/K[7]/P 65 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
17 0 obj<</ActualText(Figma)/K[8]/P 66 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
18 0 obj<</ActualText(Desktop & Mobile \(Designed Separately\))/K[9]/P 67 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
19 0 obj<</ActualText( ’Problems)/K[10]/P 68 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
20 0 obj<</ActualText(Customers often have limited visibility into the status of their shipments, making it difficult to know where a parcel is or when it will arrive. Courier companies also need an organized system to manage shipments, update delivery statuses, and provide accurate tracking information.)/K[11]/P 69 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
21 0 obj<</ActualText( ’Goals)/K[12]/P 70 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
22 0 obj<</ActualText(The goal of the project was to:)/K[13]/P 71 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
23 0 obj<</K[14]/P 72 0 R/S/Span/Pg 8 0 R/Type/StructElem>>
endobj
24 0 obj<</ActualText( ’Target Users)/K[15]/P 73 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
25 0 obj<</ActualText(01)/K[16]/P 74 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
26 0 obj<</ActualText(Customers)/K[17]/P 75 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
27 0 obj<</ActualText(02)/K[18]/P 76 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
28 0 obj<</ActualText(Courier Staff)/K[19]/P 77 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
29 0 obj<</ActualText(03)/K[20]/P 78 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
30 0 obj<</ActualText(Online Shoppers)/K[21]/P 79 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
31 0 obj<</ActualText(04)/K[22]/P 80 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
32 0 obj<</ActualText(Businesses)/K[23]/P 81 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
33 0 obj<</ActualText( ’Key insights)/K[24]/P 82 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
34 0 obj<</ActualText(During the design process, I focused on making parcel tracking simple and easy to understand.)/K[25]/P 83 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
35 0 obj<</K[26]/P 84 0 R/S/Span/Pg 8 0 R/Type/StructElem>>
endobj
36 0 obj<</ActualText( ’Final UI)/K[27]/P 85 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
37 0 obj<</ActualText( ’Prototype)/K[28]/P 86 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
38 0 obj<</ActualText(Two interactive Figma prototypes were created to demonstrate the user experience across both platforms. The desktop prototype showcases the complete web interface, while the mobile prototype presents a dedicated mobile experience optimized for smaller screens.)/K[29]/P 87 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
39 0 obj<</ActualText(View Desktop Prototype ’ )/K[30]/P 88 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
40 0 obj<</ActualText(View Mobile Prototype ’ )/K[31]/P 89 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
41 0 obj<</ActualText( ’Design System)/K[32]/P 90 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
42 0 obj<</ActualText(The interface follows a clean and consistent design system to improve usability and readability.)/K[33]/P 91 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
43 0 obj<</ActualText(333F45)/K[34]/P 92 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
44 0 obj<</ActualText(55666F)/K[35]/P 93 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
45 0 obj<</ActualText(FDA929)/K[36]/P 94 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
46 0 obj<</ActualText( ’challenges  AND design decision)/K[37]/P 95 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
47 0 obj<</ActualText(Challenges)/K[38]/P 96 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
48 0 obj<</ActualText(As my first UI/UX project, one of the main challenges was organizing tracking information into a layout that was easy to understand. Another challenge was creating separate desktop and mobile designs while maintaining visual consistency across both interfaces.)/K[39]/P 97 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
49 0 obj<</ActualText(Decision Outcomes)/K[40]/P 98 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
50 0 obj<</ActualText(To address these challenges, I designed a simple navigation structure, created a prominent tracking search section, organized shipment information into clean cards and sections, and used clear status indicators to help users understand delivery progress. I also designed dedicated desktop and mobile interfaces, ensuring each platform provided a straightforward and intuitive experience.)/K[41]/P 99 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
51 0 obj<</ActualText( ’What i Learned)/K[42]/P 100 0 R/Pg 8 0 R/S/Span/Type/StructElem>>
endobj
52 0 obj<</K[43]/P 101 0 R/S/Span/Pg 8 0 R/Type/StructElem>>
endobj
